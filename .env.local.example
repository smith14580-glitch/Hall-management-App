# Copy to .env.local and fill in real values. Never commit .env.local.
# NEXT_PUBLIC_API_URL = the FastAPI backend base URL (no trailing slash).
# Example local dev: http://localhost:8000
# Example production (Render): https://marque-one-api.onrender.com
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=MARQUE ONE
# Optional demo mode. Default is false (real API only).
# Set to true ONLY to preview the UI without a backend; every page then
# shows a visible "SAMPLE DATA — demo only" banner. Never true in production.
NEXT_PUBLIC_USE_SAMPLE_DATA=false
